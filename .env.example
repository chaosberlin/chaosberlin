# Copy to .env (never commit .env). Bun auto-loads .env.
# You said you'll add real values later — placeholders below are enough to boot in dev.

# The domain subdomains are handed out under. DNS itself is written by chaosberlin/backend.
BASE_DOMAIN=chaos.berlin

# GitHub OAuth App — https://github.com/settings/developers
# Callback URL must be http://localhost:3000/api/auth/callback for local dev
GITHUB_CLIENT_ID=changeme
GITHUB_CLIENT_SECRET=changeme
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/callback

# Random 32+ char string for signing session cookies
SESSION_SECRET=changeme-generate-with-openssl-rand-hex-32

PORT=3000
